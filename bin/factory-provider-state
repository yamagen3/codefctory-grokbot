#!/usr/bin/env python3
"""factory-provider-state — remember a provider's usage limit and park until reset.

State lives in $FACTORY_PROVIDER_STATE_DIR (default <repo>/local/status/providers).

  classify <usage-jsonl-file>   limited <reset_epoch> <reason> | ok
  classify-text <file>...       same, from the last 200 lines of each text file
  ingest <provider> <file>      classify a JSON object or JSONL and record a limit
  mark <provider> <reset_epoch> <reason...>
  clear <provider>
  check <provider>              limited <reset_epoch> <iso> (exit 75) | ok
  should-notify <provider>      exit 0 once per state file (sets notified=true)
  wait <provider> [--max-sec N] sleep until reset when it is close enough (exit 0), else exit 75
"""
import fcntl
import json
import os
import re
import sys
import tempfile
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

BIN_DIR = Path(__file__).resolve().parent
REPO_ROOT = BIN_DIR.parent
DEFAULT_STATE_DIR = REPO_ROOT / "local" / "status" / "providers"
DEFAULT_PARK_SEC = 3600
DEFAULT_MAX_WAIT_SEC = 21600
LIMIT_STATUSES = {429, 529}
LIMIT_ERRORS = {
    "usage_limit_reached",
    "rate_limit_error",
    "rate_limited",
    "overloaded_error",
}
RESET_RE = re.compile(
    r"resets (\d{1,2})(?::(\d{2}))?\s*(am|pm)\s*\(([^)]+)\)",
    re.IGNORECASE,
)


def env_int(name, default):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return int(raw)
    except (TypeError, ValueError):
        return default


def env_float(name, default):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        return float(raw)
    except (TypeError, ValueError):
        return default


def state_dir():
    raw = os.environ.get("FACTORY_PROVIDER_STATE_DIR")
    return Path(raw) if raw else DEFAULT_STATE_DIR


def state_path(provider):
    if not provider or "/" in provider or provider in (".", ".."):
        raise ValueError("invalid provider name")
    return state_dir() / (provider + ".json")


def iso_time(epoch):
    return datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


RESULT_KEYS = ("api_error", "api_error_status", "result", "result_head")


def is_result_record(data):
    if not isinstance(data, dict):
        return False
    if data.get("source") in ("claude-cli.result", "claude-agent-sdk.result"):
        return True
    if data.get("type") == "result":
        return True
    return any(key in data and data[key] is not None for key in RESULT_KEYS)


def read_result_record(path):
    records = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    data = json.loads(line)
                except (TypeError, ValueError):
                    continue
                if is_result_record(data):
                    records.append(data)
    except OSError:
        return None
    return records[-1] if records else None


def read_result_any(path):
    """A whole-file JSON object (pretty-printed allowed) or JSONL."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    try:
        data = json.loads(text)
    except (TypeError, ValueError):
        return read_result_record(path)
    if isinstance(data, dict):
        return data
    if isinstance(data, list):
        for item in reversed(data):
            if is_result_record(item):
                return item
    return read_result_record(path)


def result_head(data):
    head = data.get("result_head")
    if isinstance(head, str):
        return head
    result = data.get("result")
    return result[:300] if isinstance(result, str) else None


def status_number(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def is_limited(data):
    if status_number(data.get("api_error_status")) in LIMIT_STATUSES:
        return True
    if data.get("api_error") in LIMIT_ERRORS:
        return True
    head = result_head(data)
    return bool(head and re.search(r"hit your .*limit", head, re.IGNORECASE))


def limit_reason(data):
    api_error = data.get("api_error")
    if isinstance(api_error, str) and api_error.strip():
        return api_error.strip()
    status = data.get("api_error_status")
    if status is not None:
        return "api_error_status=" + str(status)
    return "usage_limit"


def is_overload(data, reason):
    status = status_number(data.get("api_error_status"))
    return reason == "overloaded_error" or (
        status == 529 and data.get("api_error") != "usage_limit_reached"
    )


def classify_record(data):
    if data is None or not is_limited(data):
        return None
    now = int(time.time())
    reason = limit_reason(data)
    if is_overload(data, reason):
        epoch = now + env_int("FACTORY_PROVIDER_OVERLOAD_PARK_SEC", 300)
    else:
        epoch = parse_reset(result_head(data), now)
    return epoch, reason


def parse_reset(head, now):
    fallback = now + env_int("FACTORY_PROVIDER_DEFAULT_PARK_SEC", DEFAULT_PARK_SEC)
    if not isinstance(head, str):
        return fallback
    match = RESET_RE.search(head)
    if not match:
        return fallback
    hour = int(match.group(1))
    minute = int(match.group(2) or 0)
    ampm = match.group(3).lower()
    zone_name = match.group(4).strip()
    if ampm == "am":
        hour = 0 if hour == 12 else hour
    else:
        hour = 12 if hour == 12 else hour + 12
    if hour > 23 or minute > 59:
        return fallback
    try:
        zone = ZoneInfo(zone_name)
    except Exception:
        return fallback
    now_dt = datetime.fromtimestamp(now, zone)
    day = now_dt.date()
    for _ in range(3):
        try:
            candidate = datetime(day.year, day.month, day.day, hour, minute, tzinfo=zone)
        except Exception:
            return fallback
        if candidate > now_dt:
            return int(candidate.timestamp())
        day += timedelta(days=1)
    return fallback


def read_state(provider):
    path = state_path(provider)
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError, TypeError):
        return None
    return data if isinstance(data, dict) else None


def remove_state(provider):
    try:
        state_path(provider).unlink()
    except OSError:
        pass


def active_reset(provider):
    data = read_state(provider)
    if data is None:
        if state_path(provider).exists():
            remove_state(provider)
        return None
    try:
        epoch = int(data.get("reset_epoch"))
    except (TypeError, ValueError):
        remove_state(provider)
        return None
    if epoch > int(time.time()):
        return epoch
    remove_state(provider)
    return None


def write_state_doc(path, doc):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(doc, fh, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_state(provider, reset_epoch, reason):
    path = state_path(provider)
    doc = {
        "provider": provider,
        "state": "limited",
        "reset_epoch": reset_epoch,
        "reason": reason,
        "marked_at": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    write_state_doc(path, doc)


def print_classification(result):
    if result is None:
        print("ok")
    else:
        print("limited {} {}".format(result[0], result[1]))


def cmd_classify(args):
    data = read_result_record(args[0]) if len(args) == 1 else None
    print_classification(classify_record(data))
    return 0


def read_text_tail(path, max_lines=200):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = [line.rstrip("\n") for line in fh]
    except OSError:
        return []
    return lines[-max_lines:]


def text_limit_reason(text):
    if "usage_limit_reached" in text:
        return "usage_limit_reached"
    api_error = re.search(r'"api_error"\s*:\s*"([^"]+)"', text)
    if api_error:
        return api_error.group(1)
    status = re.search(r'"api_error_status"\s*:\s*(429|529)', text)
    if status:
        return "api_error_status=" + status.group(1)
    return "usage_limit"


def cmd_classify_text(args):
    lines = []
    for path in args:
        lines.extend(read_text_tail(path))
    text = "\n".join(lines)
    if not (
        "usage_limit_reached" in text
        or re.search(r"hit your .{0,40}limit", text, re.IGNORECASE)
        or re.search(r'"api_error_status"\s*:\s*(429|529)', text)
    ):
        print("ok")
        return 0
    now = int(time.time())
    epoch = parse_reset(text, now)
    print("limited {} {}".format(epoch, text_limit_reason(text)))
    return 0


def cmd_ingest(args):
    if len(args) != 2:
        return usage_error("ingest <provider> <file>")
    provider, path = args
    try:
        state_path(provider)
    except ValueError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    result = classify_record(read_result_any(path))
    if result is None:
        print("ok")
        return 0
    epoch, reason = result
    try:
        write_state(provider, epoch, reason)
    except OSError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    print("limited {} {}".format(epoch, reason))
    return 0


def cmd_mark(args):
    if len(args) < 3:
        return usage_error("mark <provider> <reset_epoch> <reason...>")
    provider, raw_epoch = args[0], args[1]
    try:
        epoch = int(raw_epoch)
        write_state(provider, epoch, " ".join(args[2:]))
    except (TypeError, ValueError, OSError) as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    return 0


def cmd_clear(args):
    if len(args) != 1:
        return usage_error("clear <provider>")
    try:
        remove_state(args[0])
    except ValueError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    return 0


def cmd_should_notify(args):
    if len(args) != 1:
        return usage_error("should-notify <provider>")
    provider = args[0]
    try:
        path = state_path(provider)
        if not path.exists():
            return 1
        dir_fd = os.open(str(path.parent), os.O_RDONLY)
        try:
            fcntl.flock(dir_fd, fcntl.LOCK_EX)
            try:
                if active_reset(provider) is None:
                    return 1
                data = read_state(provider)
                if data is None or data.get("notified"):
                    return 1
                data["notified"] = True
                write_state_doc(path, data)
            finally:
                fcntl.flock(dir_fd, fcntl.LOCK_UN)
        finally:
            os.close(dir_fd)
    except ValueError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    except OSError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    return 0


def cmd_check(args):
    if len(args) != 1:
        return usage_error("check <provider>")
    try:
        epoch = active_reset(args[0])
    except ValueError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    if epoch is None:
        print("ok")
        return 0
    print("limited {} {}".format(epoch, iso_time(epoch)))
    return 75


def cmd_wait(args):
    if not args:
        return usage_error("wait <provider> [--max-sec N]")
    provider = args[0]
    max_sec = env_int("FACTORY_PROVIDER_MAX_WAIT_SEC", DEFAULT_MAX_WAIT_SEC)
    rest = args[1:]
    if rest:
        if len(rest) == 2 and rest[0] == "--max-sec":
            try:
                max_sec = int(rest[1])
            except ValueError:
                return usage_error("wait <provider> [--max-sec N]")
        else:
            return usage_error("wait <provider> [--max-sec N]")
    try:
        epoch = active_reset(provider)
    except ValueError as exc:
        print("factory-provider-state: {}".format(exc), file=sys.stderr)
        return 2
    if epoch is None:
        return 0
    remaining = epoch - time.time()
    if remaining + 60 > max_sec:
        return 75
    scale = max(0.0, env_float("FACTORY_PROVIDER_SLEEP_SCALE", 1.0))
    # One minute past the announced reset, so the next call does not land on the edge.
    sleep_for = (max(0.0, remaining) + 60) * scale
    if sleep_for > 0:
        time.sleep(sleep_for)
    return 0


def usage_error(text):
    print("usage: factory-provider-state " + text, file=sys.stderr)
    return 2


def main(argv):
    usage = "{classify|classify-text|ingest|mark|clear|check|should-notify|wait} ..."
    if len(argv) < 2:
        return usage_error(usage)
    cmd, args = argv[1], argv[2:]
    handlers = {
        "classify": cmd_classify,
        "classify-text": cmd_classify_text,
        "ingest": cmd_ingest,
        "mark": cmd_mark,
        "clear": cmd_clear,
        "check": cmd_check,
        "should-notify": cmd_should_notify,
        "wait": cmd_wait,
    }
    handler = handlers.get(cmd)
    if handler is None:
        return usage_error(usage)
    return handler(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
