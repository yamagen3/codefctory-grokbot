#!/usr/bin/env bash
# Create / merge PRs via FACTORY_BACKEND.
# Usage:
#   factory-pr create <repo> <id> <title> [body]
#   factory-pr merge <repo> <id> [sha]
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"
export PYTHONPATH="${FACTORY_ROOT}/lib${PYTHONPATH:+:$PYTHONPATH}"
CMD="${1:-}"; shift || true
case "$CMD" in
  create)
    REPO="${1:-}"; ID="${2:-}"; TITLE="${3:-}"; BODY="${4:-}"
    [[ -n "$REPO" && -n "$ID" && -n "$TITLE" ]] || die "usage: factory-pr create <repo> <id> <title> [body]"
REPO="$(resolve_repo "$REPO")"
    exec python3 -m factory_github pr-create "$REPO" "$ID" "$TITLE" "$BODY"
    ;;
  merge)
    REPO="${1:-}"; ID="${2:-}"; SHA="${3:-}"
    [[ -n "$REPO" && -n "$ID" ]] || die "usage: factory-pr merge <repo> <id> [sha]"
REPO="$(resolve_repo "$REPO")"
    exec python3 -m factory_github pr-merge "$REPO" "$ID" ${SHA:+"$SHA"}
    ;;
  *) die "usage: factory-pr create|merge ..." ;;
esac
