#!/usr/bin/env bash
# Idempotent install of a pinned pstack-claude skill subset for factory agents.
# - Claude Code user files: ~/.claude/skills/<name>
#   Files alone do not enter the CC prompt. factory-setup's CC patch spreads
#   pstackQueryOverlay() into the Agent SDK query (docs/pstack-cc.md).
# - OpenCode (factory-oc + bwrap): /home/factory-oc/.agents/skills/<name>
#   (also mirrored under /home/factory-oc/.config/opencode/skills for discovery)
# Never mounts /workspace/factory into OpenCode; skills are copied into factory-oc HOME.
# Does not widen CC FS allowlist or OC sandbox. Does not install the pstack
# marketplace plugin or its SessionStart hook.
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"

# michael-denyer/pstack-claude — Claude Code / OpenCode port of Lauren Tan's pstack
PSTACK_REPO_URL="${FACTORY_PSTACK_REPO_URL:-https://github.com/michael-denyer/pstack-claude.git}"
PSTACK_PIN_SHA="${FACTORY_PSTACK_PIN_SHA:-79b36d9b53a53c78e5ec26bf6ce7dade76686c87}"
PSTACK_SRC="${FACTORY_PSTACK_SRC:-$FACTORY_ROOT/tools/pstack-claude}"
SKILLS_SRC="$PSTACK_SRC/plugins/pstack/skills"
MANIFEST="$FACTORY_ROOT/config/pstack-skills.manifest"

# Subset: principles + core playbooks useful for spec/impl/gate.
# Excluded (see DECISIONS.md): arena/swarm/reflect (uncontrolled multi-model spawn),
# ketchup-video, setup-pstack, GH babysit/CI helpers, skill-authoring/meta maintainers,
# thermos/thermo-nuclear (heavy review spawn), recall/what-did-i-get-done (session-history).
DEFAULT_SKILLS=(
  architect
  blast-radius
  bro
  correct
  deslop
  figure-it-out
  how
  in-your-own-words
  interrogate
  no-comments
  poteto-help
  poteto-mode
  principle-attack-the-premise
  principle-boundary-discipline
  principle-build-the-lever
  principle-encode-lessons-in-structure
  principle-exhaust-the-design-space
  principle-experience-first
  principle-explain-the-number
  principle-fix-root-causes
  principle-foundational-thinking
  principle-guard-the-context-window
  principle-laziness-protocol
  principle-make-operations-idempotent
  principle-migrate-callers-then-delete-legacy-apis
  principle-minimize-reader-load
  principle-model-the-domain
  principle-never-block-on-the-human
  principle-outcome-oriented-execution
  principle-prove-it-works
  principle-redesign-from-first-principles
  principle-separate-before-serializing-shared-state
  principle-sequence-verifiable-units
  principle-subtract-before-you-add
  principle-test-behavior-not-implementation
  principle-type-system-discipline
  sharpen
  show-me-your-work
  tdd
  teach
  technical-writing
  typescript-best-practices
  unslop
  why
)

read_manifest() {
  if [[ -f "$MANIFEST" ]]; then
    grep -vE '^\s*(#|$)' "$MANIFEST" || true
  else
    printf '%s\n' "${DEFAULT_SKILLS[@]}"
  fi
}

ensure_checkout() {
  mkdir -p "$(dirname "$PSTACK_SRC")"
  if [[ -d "$PSTACK_SRC/.git" ]]; then
    local cur
    cur=$(git -C "$PSTACK_SRC" rev-parse HEAD 2>/dev/null || echo "")
    if [[ "$cur" == "$PSTACK_PIN_SHA" ]]; then
      echo "factory-pstack-install: checkout already at $PSTACK_PIN_SHA"
      return 0
    fi
    echo "factory-pstack-install: fetching pin $PSTACK_PIN_SHA"
    git -C "$PSTACK_SRC" fetch --depth 1 origin "$PSTACK_PIN_SHA" 2>/dev/null \
      || git -C "$PSTACK_SRC" fetch origin "$PSTACK_PIN_SHA"
    git -C "$PSTACK_SRC" checkout --detach "$PSTACK_PIN_SHA"
  else
    echo "factory-pstack-install: cloning $PSTACK_REPO_URL @ $PSTACK_PIN_SHA"
    rm -rf "$PSTACK_SRC"
    git clone --filter=blob:none --no-checkout "$PSTACK_REPO_URL" "$PSTACK_SRC"
    git -C "$PSTACK_SRC" fetch --depth 1 origin "$PSTACK_PIN_SHA"
    git -C "$PSTACK_SRC" checkout --detach "$PSTACK_PIN_SHA"
  fi
  local got
  got=$(git -C "$PSTACK_SRC" rev-parse HEAD)
  [[ "$got" == "$PSTACK_PIN_SHA" ]] || {
    echo "factory-pstack-install: SHA mismatch got=$got want=$PSTACK_PIN_SHA" >&2
    exit 1
  }
  [[ -d "$SKILLS_SRC" ]] || {
    echo "factory-pstack-install: missing $SKILLS_SRC" >&2
    exit 1
  }
}

install_one() {
  local name="$1" dest_root="$2"
  local src="$SKILLS_SRC/$name"
  local dest="$dest_root/$name"
  [[ -d "$src" && -f "$src/SKILL.md" ]] || {
    echo "factory-pstack-install: WARN skip missing skill $name" >&2
    return 0
  }
  mkdir -p "$dest_root"
  rm -rf "$dest"
  cp -a "$src" "$dest"
  # Stamp for doctor
  printf '%s\n' "$PSTACK_PIN_SHA" > "$dest/.factory-pstack-sha"
}

install_to() {
  local dest_root="$1" label="$2"
  local n=0
  mkdir -p "$dest_root"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    install_one "$name" "$dest_root"
    n=$((n + 1))
  done < <(read_manifest)
  echo "factory-pstack-install: $label → $dest_root ($n skills, pin=$PSTACK_PIN_SHA)"
}

# Write default manifest if absent (tracked in factory repo)
if [[ ! -f "$MANIFEST" ]]; then
  {
    echo "# Factory pstack skill subset (one name per line). See bin/factory-pstack-install."
    echo "# Source: michael-denyer/pstack-claude @ $PSTACK_PIN_SHA"
    printf '%s\n' "${DEFAULT_SKILLS[@]}"
  } > "$MANIFEST"
  echo "factory-pstack-install: wrote $MANIFEST"
fi

ensure_checkout

# Claude Code user skills. The SDK loads this directory only as setting source "user".
install_to "${HOME}/.claude/skills" "claude-code"

# OpenCode under factory-oc home (bwrap bind-mounts /home/factory-oc)
OC_AGENTS="/home/factory-oc/.agents/skills"
OC_CFG="/home/factory-oc/.config/opencode/skills"
if id factory-oc >/dev/null 2>&1; then
  sudo -n mkdir -p "$OC_AGENTS" "$OC_CFG" /home/factory-oc/.agents
  # Install into a staging dir then chown — avoid writing as box into OC home directly when perms block
  STAGE=$(mktemp -d /tmp/factory-pstack-oc-XXXXXX)
  install_to "$STAGE" "opencode-stage"
  sudo -n rm -rf "$OC_AGENTS"
  sudo -n mkdir -p "$OC_AGENTS"
  sudo -n cp -a "$STAGE"/. "$OC_AGENTS"/
  # Mirror into config/opencode/skills (some OC versions also scan here; keep agmsg if present)
  if sudo -n test -d /home/factory-oc/.config/opencode/skills/agmsg 2>/dev/null; then
    :
  fi
  # Symlink each skill from agents → config for dual discovery (relative within home)
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    sudo -n rm -rf "$OC_CFG/$name"
    sudo -n ln -sfn "../../.agents/skills/$name" "$OC_CFG/$name"
  done < <(read_manifest)
  sudo -n chown -R factory-oc:factory-oc /home/factory-oc/.agents /home/factory-oc/.config/opencode/skills
  rm -rf "$STAGE"
  echo "factory-pstack-install: opencode → $OC_AGENTS (+ config symlinks)"
else
  echo "factory-pstack-install: WARN user factory-oc missing; skipped OC install" >&2
fi

# Marker for doctor
mkdir -p "$FACTORY_ROOT/local"
echo "$PSTACK_PIN_SHA" > "$FACTORY_ROOT/local/pstack-installed-sha"
echo "factory-pstack-install: done pin=$PSTACK_PIN_SHA"
