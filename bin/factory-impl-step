#!/usr/bin/env bash
# Impl step: N parallel OpenCode workspaces, patch-extract,
# acceptance-scored winner → clean clone commit.
# N resolution: FACTORY_OC_PARALLEL (env override) → spec/IMPL_STRATEGY.md → default 2.
# N=1 keeps a single-slot path; empty/fail across all slots exits non-zero.
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"

REPO="${1:-}"; ID="${2:-}"; shift 2 || true
[[ -n "$REPO" && -n "$ID" ]] || die "usage: factory-impl-step <clean-clone-repo> <id> [prompt...]"
REPO="$(resolve_repo "$REPO")"
[[ -d "$REPO/.git" ]] || die "not a git repo: $REPO"

# Resolve N: env override → CC strategy file → parallel-first default 2.
PARALLEL_SOURCE=default
PARALLEL=""
if [[ -n "${FACTORY_OC_PARALLEL+x}" && -n "${FACTORY_OC_PARALLEL}" ]]; then
  PARALLEL="$FACTORY_OC_PARALLEL"
  PARALLEL_SOURCE=env
  echo "factory-impl-step: FACTORY_OC_PARALLEL=${PARALLEL} overrides strategy (tests/emergency)" >&2
else
  STRATEGY="${REPO}/spec/IMPL_STRATEGY.md"
  if [[ -f "$STRATEGY" ]]; then
    # Prefer first machine-readable "parallel: N" (also works inside a YAML fence).
    parsed=$(grep -E '^[[:space:]]*parallel:[[:space:]]*[0-9]+' "$STRATEGY" | head -1 | sed -E 's/^[[:space:]]*parallel:[[:space:]]*([0-9]+).*/\1/' || true)
    if [[ "$parsed" =~ ^[1-9][0-9]*$ ]]; then
      PARALLEL="$parsed"
      PARALLEL_SOURCE=spec
    else
      echo "factory-impl-step: WARNING invalid parallel in spec/IMPL_STRATEGY.md — defaulting to 2" >&2
      PARALLEL=2
      PARALLEL_SOURCE=default
    fi
  else
    echo "factory-impl-step: WARNING missing spec/IMPL_STRATEGY.md — defaulting to parallel=2 (parallel-first)" >&2
    PARALLEL=2
    PARALLEL_SOURCE=default
  fi
fi
if ! [[ "$PARALLEL" =~ ^[1-9][0-9]*$ ]]; then
  echo "factory-impl-step: WARNING non-integer parallel=${PARALLEL} — defaulting to 2" >&2
  PARALLEL=2
  PARALLEL_SOURCE=default
fi
if [[ "$PARALLEL" -lt 1 ]]; then PARALLEL=1; fi
if [[ "$PARALLEL" -gt 4 ]]; then PARALLEL=4; fi
echo "factory-impl-step: parallel=${PARALLEL} source=${PARALLEL_SOURCE}"

PROMPT="${*:-Implement per spec/PRODUCT.md so tests/acceptance pass. Stdlib only. Minimal changes. Do not modify spec/ or tests/acceptance/ or .github/.}"
STEP_BIN="${FACTORY_STEP_BIN:-factory-step}"
LOG_DIR="${FACTORY_ROOT}/local/logs"
mkdir -p "$LOG_DIR"
# Workspace and slot-home roots are root-owned on a normal host. Fall back to sudo
# when the invoking user cannot create them (original host already has both).
mkdir -p /var/factory/oc-workspaces /var/factory/oc-homes 2>/dev/null \
  || sudo -n mkdir -p /var/factory/oc-workspaces /var/factory/oc-homes
sudo -n chmod 1777 /var/factory/oc-workspaces /var/factory/oc-homes 2>/dev/null \
  || chmod 1777 /var/factory/oc-workspaces /var/factory/oc-homes 2>/dev/null || true

RUN_TAG="impl-${ID}-$$"
SEED=$(mktemp -d /tmp/factory-seed-XXXXXX)
PARALLEL_JSON="${LOG_DIR}/impl-${ID}-parallel.json"
EVAL_ROOT=$(mktemp -d /tmp/factory-impl-eval-XXXXXX)

cleanup() {
  rm -rf "$SEED" "$EVAL_ROOT"
}
trap cleanup EXIT

cp -a "$REPO"/. "$SEED"/
rm -rf "$SEED/.git"
rm -rf "$SEED"/tmp "$SEED"/tmp.* 2>/dev/null || true

seed_oc_home() {
  local dest="$1"
  mkdir -p "$dest"/{bin,.config/opencode,.local/share/opencode,.cache,.agents/skills}
  if sudo -n test -d /home/factory-oc/.config/opencode 2>/dev/null; then
    sudo -n cp -a /home/factory-oc/.config/opencode/. "$dest/.config/opencode/" 2>/dev/null || true
  fi
  if sudo -n test -d /home/factory-oc/.agents/skills 2>/dev/null; then
    sudo -n cp -a /home/factory-oc/.agents/skills/. "$dest/.agents/skills/" 2>/dev/null || true
  fi
  sudo -n chown -R factory-oc:factory-oc "$dest" 2>/dev/null || true
  sudo -n chmod -R a+rwX "$dest" 2>/dev/null || chmod -R a+rwX "$dest" 2>/dev/null || true
}

count_acceptance_pass() {
  # Print number of passing acceptance tests (0 if discover/run fails).
  local clone="$1"
  local py out
  py="${FACTORY_PYTHON:-}"
  if [[ -z "$py" ]]; then
    if command -v python3.12 >/dev/null; then py=python3.12; else py=python3; fi
  fi
  [[ -d "$clone/tests/acceptance" ]] || { echo 0; return 0; }
  set +e
  out=$(cd "$clone" && PYTHONPATH=src "$py" -m unittest discover -s tests/acceptance -v 2>&1)
  set -e
  # Count unittest verbose "ok" lines; treat missing suite as 0.
  printf '%s\n' "$out" | grep -c ' \.\.\. ok$' || true
}

declare -a WS_LIST=() HOME_LIST=() RESULT_LIST=() PATCH_LIST=() EC_LIST=()
declare -a ACC_LIST=() NONEMPTY_LIST=() MAKE_EC_LIST=()

for i in $(seq 1 "$PARALLEL"); do
  WS="/var/factory/oc-workspaces/${RUN_TAG}-s${i}"
  OC_HOME="/var/factory/oc-homes/${RUN_TAG}-s${i}"
  RESULT="${LOG_DIR}/impl-${ID}-$$-s${i}.json"
  PATCH="/tmp/factory-impl-${ID}-$$-s${i}.patch"
  sudo -n rm -rf "$WS" "$OC_HOME" 2>/dev/null || rm -rf "$WS" "$OC_HOME" 2>/dev/null || true
  mkdir -p "$WS"
  cp -a "$SEED"/. "$WS"/
  rm -rf "$WS/.git"
  sudo -n chown -R factory-oc:factory-oc "$WS" 2>/dev/null || true
  # Host perms: parent is 1777; keep tree writable so orchestrator/mocks can seed markers.
  # Real OC writes as factory-oc inside bwrap regardless.
  sudo -n chmod -R a+rwX "$WS" 2>/dev/null || chmod -R a+rwX "$WS" 2>/dev/null || true
  seed_oc_home "$OC_HOME"
  WS_LIST+=("$WS")
  HOME_LIST+=("$OC_HOME")
  RESULT_LIST+=("$RESULT")
  PATCH_LIST+=("$PATCH")
done

# Fan-out: one factory-step (OpenCode process) per slot.
PIDS=()
for i in $(seq 1 "$PARALLEL"); do
  idx=$((i - 1))
  (
    export FACTORY_PROVIDER=opencode
    export FACTORY_OC_WORKSPACE="${WS_LIST[$idx]}"
    export FACTORY_OC_HOME="${HOME_LIST[$idx]}"
    set +e
    FACTORY_USAGE_STEP="impl-s${i}" FACTORY_USAGE_RUN_ID="${FACTORY_USAGE_RUN_ID:-$ID}" \
      "$STEP_BIN" --json "$PROMPT" > "${RESULT_LIST[$idx]}" 2>&1
    echo $? > "${RESULT_LIST[$idx]}.ec"
  ) &
  PIDS+=($!)
done

TIMEOUT_SEC="${FACTORY_IMPL_PARALLEL_TIMEOUT_SEC:-0}"
if [[ "$TIMEOUT_SEC" =~ ^[1-9][0-9]*$ ]]; then
  deadline=$((SECONDS + TIMEOUT_SEC))
  for pid in "${PIDS[@]}"; do
    while kill -0 "$pid" 2>/dev/null; do
      if [[ "$SECONDS" -ge "$deadline" ]]; then
        echo "factory-impl-step: parallel timeout ${TIMEOUT_SEC}s — killing pid $pid" >&2
        kill "$pid" 2>/dev/null || true
        sleep 1
        kill -9 "$pid" 2>/dev/null || true
        break
      fi
      sleep 0.2
    done
    wait "$pid" 2>/dev/null || true
  done
else
  for pid in "${PIDS[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
fi

for i in $(seq 1 "$PARALLEL"); do
  idx=$((i - 1))
  if [[ -f "${RESULT_LIST[$idx]}.ec" ]]; then
    EC_LIST+=("$(tr -d '[:space:]' < "${RESULT_LIST[$idx]}.ec")")
  else
    EC_LIST+=(1)
  fi
  # Hand the workspace back to the invoking user (original host: box). `|| true` keeps a
  # missing sudo from failing the step; the name is not hardcoded.
  host_user="${SUDO_USER:-$(id -un)}"
  host_group="$(id -gn "$host_user" 2>/dev/null || id -gn)"
  sudo -n chown -R "${host_user}:${host_group}" "${WS_LIST[$idx]}" 2>/dev/null || true
  find "${WS_LIST[$idx]}" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  find "${WS_LIST[$idx]}" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete 2>/dev/null || true
done

# Per-slot: extract patch → apply on fresh temp clone → acceptance count.
BEST_I=0
BEST_OC_OK=-1
BEST_ACC=-1
BEST_NONEMPTY=-1

for i in $(seq 1 "$PARALLEL"); do
  idx=$((i - 1))
  WS="${WS_LIST[$idx]}"
  PATCH="${PATCH_LIST[$idx]}"
  EC="${EC_LIST[$idx]}"
  OC_OK=0
  [[ "$EC" == "0" ]] && OC_OK=1

  set +e
  factory-patch-extract make "$WS" "$SEED" "$PATCH" >/tmp/factory-impl-make-s${i}.log 2>&1
  MAKE_EC=$?
  set -e
  MAKE_EC_LIST+=("$MAKE_EC")

  NONEMPTY=0
  if [[ -f "$PATCH" ]] && grep -qE '^\+\+\+ ' "$PATCH" 2>/dev/null; then
    NONEMPTY=1
  fi
  NONEMPTY_LIST+=("$NONEMPTY")

  ACC=0
  if [[ "$NONEMPTY" -eq 1 && "$MAKE_EC" -eq 0 ]]; then
    CLONE="${EVAL_ROOT}/s${i}"
    rm -rf "$CLONE"
    # Fresh clone of REPO (not the main work tree).
    if git clone --quiet "$REPO" "$CLONE" 2>/dev/null; then
      :
    else
      mkdir -p "$CLONE"
      cp -a "$REPO"/. "$CLONE"/
    fi
    set +e
    factory-patch-extract apply "$CLONE" "$PATCH" >/tmp/factory-impl-apply-s${i}.log 2>&1
    APPLY_EC=$?
    set -e
    if [[ "$APPLY_EC" -eq 0 ]]; then
      ACC=$(count_acceptance_pass "$CLONE")
      ACC=$(echo "$ACC" | tr -d '[:space:]')
      [[ "$ACC" =~ ^[0-9]+$ ]] || ACC=0
    fi
  fi
  ACC_LIST+=("$ACC")

  # Winner: OC exit 0, then most acceptance passes, then non-empty patch, then lower index.
  better=0
  if [[ "$OC_OK" -gt "$BEST_OC_OK" ]]; then better=1
  elif [[ "$OC_OK" -eq "$BEST_OC_OK" && "$ACC" -gt "$BEST_ACC" ]]; then better=1
  elif [[ "$OC_OK" -eq "$BEST_OC_OK" && "$ACC" -eq "$BEST_ACC" && "$NONEMPTY" -gt "$BEST_NONEMPTY" ]]; then better=1
  elif [[ "$OC_OK" -eq "$BEST_OC_OK" && "$ACC" -eq "$BEST_ACC" && "$NONEMPTY" -eq "$BEST_NONEMPTY" && ( "$BEST_I" -eq 0 || "$i" -lt "$BEST_I" ) ]]; then better=1
  fi
  if [[ "$better" -eq 1 ]]; then
    BEST_I=$i
    BEST_OC_OK=$OC_OK
    BEST_ACC=$ACC
    BEST_NONEMPTY=$NONEMPTY
  fi

  echo "factory-impl-step: slot=s${i} oc_ec=${EC} make_ec=${MAKE_EC} nonempty=${NONEMPTY} acceptance_pass=${ACC} ws=${WS}"
done

# Write parallel summary JSON (no secrets).
SLOT_META=$(mktemp /tmp/factory-impl-slots-XXXXXX)
for i in $(seq 1 "$PARALLEL"); do
  idx=$((i - 1))
  printf "%s\t%s\t%s\t%s\t%s\t%s\n" \
    "$i" "${EC_LIST[$idx]}" "${ACC_LIST[$idx]}" "${NONEMPTY_LIST[$idx]}" \
    "${WS_LIST[$idx]}" "${PATCH_LIST[$idx]}" >> "$SLOT_META"
done
ID="$ID" PARALLEL="$PARALLEL" PARALLEL_SOURCE="$PARALLEL_SOURCE" BEST_I="$BEST_I" RUN_TAG="$RUN_TAG" \
  PARALLEL_JSON="$PARALLEL_JSON" SLOT_META="$SLOT_META" python3 <<"PY"
import json, os
slots = []
with open(os.environ["SLOT_META"]) as f:
    for line in f:
        slot, oc_ec, acc, nonempty, ws, patch = line.rstrip("\n").split("\t", 5)
        slots.append({
            "slot": int(slot),
            "oc_ec": int(oc_ec),
            "acceptance_pass": int(acc),
            "nonempty": int(nonempty),
            "workspace": ws,
            "patch": patch,
        })
doc = {
    "id": os.environ["ID"],
    "parallel": int(os.environ["PARALLEL"]),
    "parallel_source": os.environ["PARALLEL_SOURCE"],
    "winner_slot": int(os.environ["BEST_I"]),
    "run_tag": os.environ["RUN_TAG"],
    "slots": slots,
}
path = os.environ["PARALLEL_JSON"]
with open(path, "w") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
print(f"factory-impl-step: wrote {path}")
PY
rm -f "$SLOT_META"

if [[ "$BEST_I" -eq 0 ]]; then
  echo "factory-impl-step: no slots evaluated" >&2
  exit 1
fi

BEST_IDX=$((BEST_I - 1))
WIN_NONEMPTY="${NONEMPTY_LIST[$BEST_IDX]}"
WIN_OC="${EC_LIST[$BEST_IDX]}"
WIN_ACC="${ACC_LIST[$BEST_IDX]}"
WIN_PATCH="${PATCH_LIST[$BEST_IDX]}"

# All empty/fail → non-zero (do not leave silent empty success).
if [[ "$WIN_NONEMPTY" != "1" ]]; then
  echo "factory-impl-step: all slots empty/fail (winner s${BEST_I} nonempty=0) — refusing" >&2
  exit 1
fi

cd "$REPO"
git checkout -B "factory/${ID}"
rm -rf tmp tmp.* 2>/dev/null || true
if ! factory-patch-extract apply "$REPO" "$WIN_PATCH"; then
  echo "factory-impl-step: winner patch apply failed (no tar fallback)" >&2
  exit 1
fi

if git diff --name-only -- spec tests/acceptance .github 2>/dev/null | grep -q .; then
  echo "factory-impl-step: WARNING stripping OC changes under protected paths" >&2
  git checkout -- spec tests/acceptance .github 2>/dev/null || true
  git clean -fd spec tests/acceptance .github 2>/dev/null || true
fi
rm -rf tmp tmp.* .factory-cc-fs-state 2>/dev/null || true

git add -A
if git -c user.email=factory@localhost -c user.name=factory \
  commit -m "factory(${ID}): OpenCode impl (slot s${BEST_I}/${PARALLEL}, oc_ec=${WIN_OC}, acceptance_pass=${WIN_ACC})"; then
  :
else
  echo "factory-impl-step: nothing to commit after winner apply" >&2
  # Nonempty patch that produces nothing to commit is still odd — treat as failure.
  exit 1
fi

echo "factory-impl-step: branch=factory/${ID} winner=s${BEST_I}/${PARALLEL} oc_ec=${WIN_OC} acceptance_pass=${WIN_ACC} workspace=${WS_LIST[$BEST_IDX]} patch=${WIN_PATCH} parallel_json=${PARALLEL_JSON}"
exit 0
