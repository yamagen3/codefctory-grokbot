#!/usr/bin/env bash
# Read-only view of what the factory is waiting on.
# Usage:
#   factory-inbox list [--json] [--all]
#   factory-inbox count
#   factory-inbox check
#   factory-inbox ack <basename>...
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"

HOOK="${FACTORY_GROK_HOOK_DIR:-$FACTORY_ROOT/local/grok-hooks}"
NOTIFY="${FACTORY_NOTIFY_DIR:-$FACTORY_ROOT/local/notify}"
export FACTORY_ROOT

exec python3 - "$HOOK" "$NOTIFY" "$@" <<'PY'
import json
import os
import sys
import time
from datetime import datetime, timezone

ATTENTION_KINDS = {
    "max-rounds",
    "stall",
    "merge-failed",
    "continue-stale",
    "continue-error",
    "grok-rejected",
    "run-aborted",
    "gate-unavailable",
    "update-deferred-repeated",
}

USAGE = (
    "usage: factory-inbox list [--json] [--all] | count | check | "
    "ack <basename>..."
)


def warn(message):
    print(f"factory-inbox: {message}", file=sys.stderr)


def as_text(value):
    if value is None:
        return ""
    return value if isinstance(value, str) else str(value)


def parse_time(value):
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    try:
        return parsed.timestamp()
    except (OverflowError, OSError, ValueError):
        return None


def file_mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def as_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float) and value.is_integer():
        return int(value)
    if isinstance(value, str):
        try:
            return int(value.strip())
        except ValueError:
            return None
    return None


def iso_time(epoch):
    return datetime.fromtimestamp(epoch).astimezone().isoformat(timespec="seconds")


def read_json_object(path, label):
    try:
        with open(path, encoding="utf-8") as handle:
            record = json.load(handle)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        warn(f"skipping {label}: {exc}")
        return None
    if not isinstance(record, dict):
        warn(f"skipping {label}: not a JSON object")
        return None
    return record


def read_acked(notify):
    path = os.path.join(notify, ".acked")
    names = set()
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                name = line.rstrip("\r\n")
                if name:
                    names.add(name)
    except FileNotFoundError:
        pass
    except OSError as exc:
        warn(f"cannot read {path}: {exc}")
    return names


def read_notification(path, basename):
    fields = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.rstrip("\r\n")
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in ("time", "kind", "message") and key not in fields:
                    fields[key] = value
    except OSError as exc:
        warn(f"skipping {basename}: {exc}")
        return None

    kind = fields.get("kind", "")
    if not kind:
        stem = basename[:-4] if basename.endswith(".txt") else basename
        kind = stem.rsplit("-", 1)[-1] if "-" in stem else stem
    return {
        "kind": kind,
        "time": fields.get("time", ""),
        "message": fields.get("message", ""),
        "file": basename,
    }


def pending_items(hook):
    items = []
    if not os.path.isdir(hook):
        return items
    try:
        names = sorted(os.listdir(hook))
    except OSError as exc:
        warn(f"cannot read {hook}: {exc}")
        return items

    prefix = "pending-"
    suffix = ".json"
    for name in names:
        if not (name.startswith(prefix) and name.endswith(suffix)):
            continue
        file_sha = name[len(prefix) : -len(suffix)]
        if not file_sha:
            continue
        path = os.path.join(hook, name)
        if not os.path.isfile(path):
            continue
        record = read_json_object(path, name)
        if record is None:
            continue
        if record.get("mode") != "pending":
            continue

        marker = os.path.join(hook, f"continued-{file_sha}.json")
        if os.path.isfile(marker):
            continue

        sha = as_text(record.get("sha")) or file_sha
        created = parse_time(record.get("created_at"))
        age = 0 if created is None else max(0, int(time.time() - created))
        item = {
            "id": as_text(record.get("id")),
            "sha": sha,
            "bundle": as_text(record.get("bundle")),
            "age_sec": age,
            "attention": True,
        }
        result = os.path.join(hook, f"result-{file_sha}.json")
        if os.path.isfile(result):
            item["action"] = f"factory-continue {sha}"
        else:
            item["action"] = (
                f'factory-gate-grok record {sha} success|failure "<reason>"'
            )
        sort_time = created if created is not None else file_mtime(path)
        items.append((sort_time, item))
    return items


def notification_items(notify, include_all):
    items = []
    if not os.path.isdir(notify):
        return items
    acked = read_acked(notify)
    try:
        names = sorted(os.listdir(notify))
    except OSError as exc:
        warn(f"cannot read {notify}: {exc}")
        return items

    for name in names:
        if not name.endswith(".txt"):
            continue
        path = os.path.join(notify, name)
        if not os.path.isfile(path):
            continue
        item = read_notification(path, name)
        if item is None:
            continue
        item["attention"] = item["kind"] in ATTENTION_KINDS and name not in acked
        if not include_all and not item["attention"]:
            continue
        sort_time = parse_time(item["time"])
        if sort_time is None:
            sort_time = file_mtime(path)
        items.append((sort_time, item))
    return items


def provider_items(state_dir, now):
    items = []
    if not os.path.isdir(state_dir):
        return items
    try:
        names = sorted(os.listdir(state_dir))
    except OSError as exc:
        warn(f"cannot read {state_dir}: {exc}")
        return items

    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(state_dir, name)
        if not os.path.isfile(path):
            continue
        record = read_json_object(path, name)
        if record is None:
            continue
        reset = as_int(record.get("reset_epoch"))
        if reset is None or reset <= now:
            continue
        try:
            until = iso_time(reset)
        except (OverflowError, OSError, ValueError):
            warn(f"skipping {name}: invalid reset_epoch")
            continue
        provider = as_text(record.get("provider")) or name[: -len(".json")]
        item = {
            "kind": "provider-limited",
            "provider": provider,
            "until": until,
            "resume_in_sec": max(0, int(reset - now)),
            "reason": as_text(record.get("reason")),
            "attention": False,
        }
        items.append((reset, item))
    return items


def parked_items(runs_dir, provider_limited):
    items = []
    if not os.path.isdir(runs_dir):
        return items
    try:
        names = sorted(os.listdir(runs_dir))
    except OSError as exc:
        warn(f"cannot read {runs_dir}: {exc}")
        return items

    for name in names:
        run_dir = os.path.join(runs_dir, name)
        if not os.path.isdir(run_dir):
            continue
        path = os.path.join(run_dir, "state.json")
        if not os.path.isfile(path):
            continue
        record = read_json_object(path, os.path.join(name, "state.json"))
        if record is None:
            continue
        if as_int(record.get("exit")) != 75:
            continue
        item = {
            "kind": "run-parked",
            "id": as_text(record.get("id")) or name,
            "stage": as_text(record.get("stage")),
            "round": record.get("round", 0),
            "sha": as_text(record.get("sha")),
            "action": "factory-resume",
            "attention": not provider_limited,
        }
        items.append((file_mtime(path), item))
    return items


def collect(hook, notify, provider_state, runs, include_all=False):
    now = time.time()
    providers = provider_items(provider_state, now)
    items = (
        pending_items(hook)
        + notification_items(notify, include_all)
        + providers
        + parked_items(runs, bool(providers))
    )
    items.sort(key=lambda pair: pair[0])
    return [item for _, item in items]


def print_list(items, as_json):
    if as_json:
        print(json.dumps(items, ensure_ascii=False))
        return
    for item in items:
        kind = item.get("kind")
        if "file" in item:
            values = [item["kind"], item["time"], item["message"], item["file"]]
        elif kind == "provider-limited":
            values = [
                item["kind"],
                item["provider"],
                item["until"],
                item["resume_in_sec"],
                item["reason"],
            ]
        elif kind == "run-parked":
            values = [
                item["kind"],
                item["id"],
                item["stage"],
                item["round"],
                item["sha"],
                item["action"],
            ]
        else:
            values = [
                item["id"],
                item["sha"],
                item["bundle"],
                item["age_sec"],
                item["action"],
            ]
        cells = [
            str(value).replace("\t", " ").replace("\r", " ").replace("\n", " ")
            for value in values
        ]
        print("\t".join(cells))


def ack(notify, names):
    for name in names:
        if "/" in name:
            warn(f"invalid notification basename: {name}")
            return 1
        path = os.path.join(notify, name)
        if not os.path.isfile(path):
            warn(f"no such notification: {name}")
            return 1

    acked_path = os.path.join(notify, ".acked")
    existing = set()
    had_acked = os.path.isfile(acked_path)
    ends_with_newline = True
    if had_acked:
        try:
            with open(acked_path, encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    name = line.rstrip("\r\n")
                    if name:
                        existing.add(name)
            with open(acked_path, "rb") as handle:
                content = handle.read()
                ends_with_newline = not content or content.endswith(b"\n")
        except OSError as exc:
            warn(f"cannot read {acked_path}: {exc}")
            return 1

    missing = []
    for name in names:
        if name not in existing and name not in missing:
            missing.append(name)
    if not missing:
        return 0

    try:
        with open(acked_path, "a", encoding="utf-8") as handle:
            if had_acked and not ends_with_newline:
                handle.write("\n")
            for name in missing:
                handle.write(name + "\n")
    except OSError as exc:
        warn(f"cannot write {acked_path}: {exc}")
        return 1
    return 0


def attention_count(items):
    return sum(1 for item in items if item.get("attention"))


def main(argv):
    hook, notify = argv[1], argv[2]
    root = os.environ.get("FACTORY_ROOT", "")
    provider_state = os.environ.get(
        "FACTORY_PROVIDER_STATE_DIR"
    ) or os.path.join(root, "local", "status", "providers")
    runs = os.environ.get("FACTORY_RUNS_DIR") or os.path.join(
        root, "local", "runs"
    )
    args = argv[3:]
    command = args[0] if args else ""

    if command == "list":
        as_json = False
        include_all = False
        for flag in args[1:]:
            if flag == "--json":
                as_json = True
            elif flag == "--all":
                include_all = True
            else:
                print(USAGE, file=sys.stderr)
                return 1
        print_list(
            collect(hook, notify, provider_state, runs, include_all), as_json
        )
        return 0

    if command == "count":
        if len(args) != 1:
            print(USAGE, file=sys.stderr)
            return 1
        print(attention_count(collect(hook, notify, provider_state, runs)))
        return 0

    if command == "check":
        if len(args) != 1:
            print(USAGE, file=sys.stderr)
            return 1
        count = attention_count(collect(hook, notify, provider_state, runs))
        print(count)
        return 10 if count else 0

    if command == "ack":
        if len(args) < 2:
            print(USAGE, file=sys.stderr)
            return 1
        return ack(notify, args[1:])

    print(USAGE, file=sys.stderr)
    return 1


sys.exit(main(sys.argv))
PY
