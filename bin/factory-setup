#!/usr/bin/env bash
# Idempotent factory host setup (no secrets printed).
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"

echo "factory-setup: root=$FACTORY_ROOT home=$HOME"

# Dirs
mkdir -p "$FACTORY_ROOT/local"/{status,labels,notify,logs,prs,grok-hooks,origin,work,tests}

# Standard Claude Code CLI at the pinned version (config/claude-code.json). The factory drives
# `claude -p` directly; there is no DSH, plugin, or Agent SDK to install (DECISIONS 2026-11-14).
# Installing the pin is not an upgrade: a newer version goes through factory-update approval.
CC_PIN=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$FACTORY_ROOT/config/claude-code.json")
CC_HAVE=$(claude --version 2>/dev/null | awk '{print $1}' || true)
if [[ "$CC_HAVE" == "$CC_PIN" ]]; then
  echo "factory-setup: claude $CC_HAVE (pinned)"
elif command -v npm >/dev/null; then
  echo "factory-setup: installing @anthropic-ai/claude-code@$CC_PIN (have ${CC_HAVE:-none})"
  npm install -g --prefix "$HOME/.local" --no-audit --no-fund "@anthropic-ai/claude-code@$CC_PIN"
  CC_HAVE=$(claude --version 2>/dev/null | awk '{print $1}' || true)
  [[ "$CC_HAVE" == "$CC_PIN" ]] || echo "factory-setup: WARN claude is ${CC_HAVE:-missing} after install, want $CC_PIN" >&2
else
  echo "factory-setup: WARN npm missing; cannot install claude $CC_PIN" >&2
fi
if npm ls -g --prefix "$HOME/.local" --depth=0 @deepseek-ai/dsh >/dev/null 2>&1; then
  echo "factory-setup: NOTE @deepseek-ai/dsh is installed but unused; remove with: npm uninstall -g --prefix \"\$HOME/.local\" @deepseek-ai/dsh"
fi

# Python 3.12 via uv if missing
if ! command -v python3.12 >/dev/null 2>&1; then
  if command -v uv >/dev/null 2>&1; then
    echo "factory-setup: installing Python 3.12 via uv"
    uv python install 3.12
    PY=$(uv python find 3.12)
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$PY" "$HOME/.local/bin/python3.12"
  else
    echo "factory-setup: WARN uv/python3.12 missing" >&2
  fi
fi

# OpenCode isolation host pieces (user factory-oc, binary, config, sudoers, workspaces) — idempotent
if [[ -x "$FACTORY_ROOT/bin/factory-oc-provision" ]]; then
  "$FACTORY_ROOT/bin/factory-oc-provision" || echo "factory-setup: WARN factory-oc-provision failed" >&2
fi

# sudoers sanity (read-only check)
if [[ -f /etc/sudoers.d/factory-oc-acp ]]; then
  echo "factory-setup: sudoers factory-oc-acp present"
else
  echo "factory-setup: WARN /etc/sudoers.d/factory-oc-acp missing" >&2
fi

# opencode binary for factory-oc
if sudo -n test -x /home/factory-oc/bin/opencode 2>/dev/null; then
  echo "factory-setup: factory-oc opencode present"
else
  echo "factory-setup: WARN /home/factory-oc/bin/opencode missing" >&2
fi

# pstack skills for CC + factory-oc OpenCode (idempotent, pinned SHA)
if [[ -x "$FACTORY_ROOT/bin/factory-pstack-install" ]]; then
  "$FACTORY_ROOT/bin/factory-pstack-install"
else
  echo "factory-setup: WARN factory-pstack-install missing" >&2
fi

echo "factory-setup: done"
