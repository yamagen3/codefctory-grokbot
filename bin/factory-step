#!/usr/bin/env bash
# factory-step — one model step through a standard CLI (no DSH).
#   FACTORY_PROVIDER=claude-code factory-step [--json] <task…>   claude -p (config/claude-code.json pins)
#   FACTORY_PROVIDER=opencode    factory-step [--json] <task…>   opencode run in the factory-oc sandbox
# The runner is lib/factory_step.py (docs/design.md §11). This wrapper owns the
# environment split, the provider-limit park/resume, and usage recording.
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/factory-common.sh"

PROVIDER="${FACTORY_PROVIDER:-claude-code}"
RESULT=""
ERR=""
CC_USAGE=""
trap 'rm -f ${RESULT:+"$RESULT"} ${ERR:+"$ERR"} ${CC_USAGE:+"$CC_USAGE"}' EXIT

# Never let Anthropic API-key auth win over Claude OAuth for CC.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN || true

case "$PROVIDER" in
  claude-code)
    # Stash OAuth; the runner hands it only to the claude child (never to OC or tool subprocesses).
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
      export FACTORY_CC_OAUTH_TOKEN="$CLAUDE_CODE_OAUTH_TOKEN"
    fi
    # Keep DeepSeek / OC keys and the OC workspace away from CC.
    unset DEEPSEEK_API_KEY OPENCODE_GO_KEY OPENCODE_API_KEY CLAUDE_CODE_OAUTH_TOKEN FACTORY_OC_WORKSPACE FACTORY_OC_API_KEY || true
    ;;
  opencode)
    if [[ -z "${OPENCODE_GO_KEY:-}" && -z "${FACTORY_OC_API_KEY:-}" ]]; then
      echo "factory-step: OPENCODE_GO_KEY required for provider=opencode" >&2
      exit 2
    fi
    # Stash under the name sudoers keeps; the launcher maps it to the sandboxed child only.
    export FACTORY_OC_API_KEY="${FACTORY_OC_API_KEY:-$OPENCODE_GO_KEY}"
    # Strip Go/DeepSeek/CC secrets; only the sandboxed OpenCode child gets the Go key.
    unset OPENCODE_GO_KEY DEEPSEEK_API_KEY OPENCODE_API_KEY OPENCODE_GO_API_KEY OPENCODE_ZEN_API_KEY \
      CLAUDE_CODE_OAUTH_TOKEN FACTORY_CC_OAUTH_TOKEN || true
    if [[ -z "${FACTORY_OC_WORKSPACE:-}" ]]; then
      FACTORY_OC_WORKSPACE="/var/factory/oc-workspaces/step-$(date +%Y%m%d-%H%M%S)-$$"
      export FACTORY_OC_WORKSPACE
      mkdir -p "$FACTORY_OC_WORKSPACE"
    fi
    rm -rf "${FACTORY_OC_WORKSPACE}/.git" 2>/dev/null || true
    cd "$FACTORY_OC_WORKSPACE"
    ;;
  *)
    echo "factory-step: unknown FACTORY_PROVIDER=$PROVIDER (use claude-code|opencode)" >&2
    exit 2
    ;;
esac

export FACTORY_PROVIDER="$PROVIDER"
export FACTORY_ROOT

PROVIDER_STATE="$FACTORY_ROOT/bin/factory-provider-state"
mark_provider_limited() {
  local classify_line="$1"
  local reset_epoch="" limit_reason="" provider_check="" limited_iso=""
  read -r _ reset_epoch limit_reason <<<"$classify_line" || true
  reset_epoch="${reset_epoch:-0}"
  limit_reason="${limit_reason:-usage_limit}"
  "$PROVIDER_STATE" mark claude-code "$reset_epoch" "$limit_reason" >/dev/null 2>&1 || true
  provider_check=$("$PROVIDER_STATE" check claude-code 2>/dev/null) || true
  read -r _ _ limited_iso <<<"$provider_check" || true
  limited_iso="${limited_iso:-@$reset_epoch}"
  echo "factory-step: claude-code limited until $limited_iso; parked (exit 75)" >&2
  if "$PROVIDER_STATE" should-notify claude-code >/dev/null 2>&1; then
    "$FACTORY_ROOT/bin/factory-notify" provider-limited "claude-code limited until $limited_iso" >/dev/null 2>&1 || true
  fi
}
if [[ "$PROVIDER" == "claude-code" && "${FACTORY_PROVIDER_IGNORE_LIMIT:-0}" != "1" ]]; then
  PROVIDER_CHECK=""
  PROVIDER_EC=0
  PROVIDER_CHECK=$("$PROVIDER_STATE" check claude-code 2>/dev/null) || PROVIDER_EC=$?
  if [[ "$PROVIDER_EC" -eq 75 ]]; then
    read -r _ _ LIMITED_ISO <<<"$PROVIDER_CHECK" || true
    LIMITED_ISO="${LIMITED_ISO:-unknown}"
    echo "factory-step: claude-code limited until $LIMITED_ISO; parked (exit 75)" >&2
    if "$PROVIDER_STATE" should-notify claude-code >/dev/null 2>&1; then
      "$FACTORY_ROOT/bin/factory-notify" provider-limited "claude-code limited until $LIMITED_ISO" >/dev/null 2>&1 || true
    fi
    exit 75
  fi
fi

# Usage tracking (local/usage/<date>/steps.jsonl). A usage failure never changes the step's stdout or exit code.
# A runner that never reaches its step-end line must still fail the step.
USAGE="$FACTORY_ROOT/bin/factory-usage"
RESULT=$(mktemp /tmp/factory-step-result-XXXXXX)
ERR=$(mktemp /tmp/factory-step-err-XXXXXX)
if [[ -z "${FACTORY_USAGE_DISABLE:-}" ]]; then
  OC_BEFORE=""
  [[ "$PROVIDER" == opencode ]] && OC_BEFORE=$("$USAGE" oc-stats 2>/dev/null || true)
  "$USAGE" agmsg-poll before >/dev/null 2>&1 || true
fi
if [[ "$PROVIDER" == claude-code ]]; then
  # Always captured: the limit classifier reads it even when usage recording is off.
  CC_USAGE=$(mktemp /tmp/factory-step-ccusage-XXXXXX); export FACTORY_CC_USAGE_FILE="$CC_USAGE"
fi
STARTED=$(date -Iseconds); T0=$(date +%s%3N)
set +e
if [[ -n "${FACTORY_STEP_RUNNER:-}" ]]; then
  RUNNER=("$FACTORY_STEP_RUNNER")
else
  RUNNER=(python3 "$FACTORY_ROOT/lib/factory_step.py")
fi
"${RUNNER[@]}" "$@" \
  > >(tee "$RESULT") 2> >(tee "$ERR" >&2)
EC=$?
wait || true
set -e
T1=$(date +%s%3N); ENDED=$(date -Iseconds)
# The runner always logs "factory: step end" last. Missing that line with empty
# stdout means the step failed to load or run.
if ! grep -q 'factory: step end ' "$ERR"; then
  if [[ "$EC" -eq 0 && ! -s "$RESULT" ]]; then
    echo "factory-step: ERROR step failed to load or run (runner exited 0 with empty stdout and no factory step result)." >&2
    if [[ -s "$ERR" ]]; then
      echo "factory-step: runner stderr:" >&2
      cat "$ERR" >&2
    else
      echo "factory-step: runner produced no stderr. Run factory-doctor / factory-setup." >&2
    fi
    EC=1
  elif [[ "$EC" -eq 0 ]] && grep -Eq 'factory: step failed to run' "$ERR"; then
    echo "factory-step: ERROR step failed to run (see factory: lines above) but the runner exited 0." >&2
    EC=1
  fi
else
  step_ec=$(sed -n 's/.*factory: step end .* exit=\([0-9][0-9]*\).*/\1/p' "$ERR" | tail -1)
  if [[ -n "${step_ec:-}" && "$step_ec" != 0 && "$EC" -eq 0 ]]; then
    echo "factory-step: ERROR step failed (step exit=${step_ec}) but the runner exited 0." >&2
    EC=$step_ec
  fi
  [[ "${step_ec:-}" == 124 ]] && EC=124
fi
LIMIT_MARKED=0
if [[ "$PROVIDER" == "claude-code" && -n "$CC_USAGE" && -f "$CC_USAGE" ]]; then
  CLASSIFY=""
  CLASSIFY_EC=0
  CLASSIFY=$("$PROVIDER_STATE" classify "$CC_USAGE" 2>/dev/null) || CLASSIFY_EC=$?
  if [[ "$CLASSIFY_EC" -eq 0 && "$CLASSIFY" == limited\ * ]]; then
    mark_provider_limited "$CLASSIFY"
    LIMIT_MARKED=1
    EC=75
  elif [[ "$CLASSIFY_EC" -eq 0 && "$CLASSIFY" == "ok" && "$EC" -eq 0 ]]; then
    "$PROVIDER_STATE" clear claude-code >/dev/null 2>&1 || true
  fi
fi
if [[ "$PROVIDER" == "claude-code" && "$EC" -ne 0 && "$EC" -ne 75 && "$LIMIT_MARKED" -eq 0 ]]; then
  TEXT_CLASSIFY=""
  TEXT_CLASSIFY_EC=0
  TEXT_CLASSIFY=$("$PROVIDER_STATE" classify-text "$ERR" "$RESULT" 2>/dev/null) || TEXT_CLASSIFY_EC=$?
  if [[ "$TEXT_CLASSIFY_EC" -eq 0 && "$TEXT_CLASSIFY" == limited\ * ]]; then
    mark_provider_limited "$TEXT_CLASSIFY"
    LIMIT_MARKED=1
    EC=75
  fi
fi
if [[ -z "${FACTORY_USAGE_DISABLE:-}" ]]; then
  OC_AFTER=""
  [[ "$PROVIDER" == opencode ]] && OC_AFTER=$("$USAGE" oc-stats 2>/dev/null || true)
  "$USAGE" record-step --provider "$PROVIDER" --started "$STARTED" --ended "$ENDED" --duration-ms $((T1 - T0)) \
    --exit "$EC" --result-file "$RESULT" ${CC_USAGE:+--cc-usage-file "$CC_USAGE"} ${OC_BEFORE:+--oc-before "$OC_BEFORE"} ${OC_AFTER:+--oc-after "$OC_AFTER"} >/dev/null 2>&1 || true
  "$USAGE" agmsg-poll after >/dev/null 2>&1 || true
fi
exit "$EC"
